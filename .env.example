# Copy to .env. Never commit it.
# The gateway is optional: connectors stay fully functional without it.

# --- Server -------------------------------------------------------------
PORT=9000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Admin (REQUIRED to manage keys; leave empty = management disabled) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CORE_ADMIN_TOKEN=

# --- Upstream connectors ------------------------------------------------
# JSON map of service -> base URL. Override any single one with CORE_*_URL.
# CORE_UPSTREAMS={"instagram":"http://127.0.0.1:3000","linkedin":"http://127.0.0.1:3002","tiktok":"http://127.0.0.1:3001"}
CORE_INSTAGRAM_URL=http://127.0.0.1:3000
CORE_LINKEDIN_URL=http://127.0.0.1:3002
CORE_TIKTOK_URL=http://127.0.0.1:3001
CORE_TIMEOUT_MS=20000

# --- Credits ------------------------------------------------------------
# Default credits for a new key / voucher.
CORE_DEFAULT_CREDITS=5000
# Per-minute rate limit per key.
CORE_RATE_PER_MIN=60
# Optional JSON array of [regex, cost] pairs. Costs follow upstream work:
# light metadata = 1, post lists = 3, aggregates = 2, people = 5.
# CORE_COSTS=[["^/v1/instagram/[^/]+/posts",3],["^/v1/linkedin/signals/",2]]

# --- Data policy --------------------------------------------------------
# Personal-data endpoints are blocked on the gateway by default.
CORE_ALLOW_PEOPLE=0
# Let clients generate their own key and send only its SHA-256 hash.
# The gateway then never sees the raw key at all.
CORE_ALLOW_CLIENT_HASH=0

# --- Storage ------------------------------------------------------------
# "file" (default) or "memory" (tests / ephemeral).
CORE_STORE=file
# CORE_DATA_DIR=./.data
# CORE_DATA_FILE=./.data/keys.json
# NO_COLOR=1
