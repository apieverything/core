# Copy to .env. Never commit it.
# The gateway is optional: connectors stay fully functional without it.

# Two credentials, deliberately distinct:
#   unlock code = 16 digits, X-Unlock-Code, opens the account (NOT an API key)
#   API key     = ae_…, X-API-Key, created/reset/revoked inside the account

# --- Server -------------------------------------------------------------
PORT=9000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Admin (REQUIRED for vouchers / operator routes; empty = disabled) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CORE_ADMIN_TOKEN=

# --- Upstream connectors ------------------------------------------------
# JSON map of service -> base URL. Override any single one with CORE_*_URL.
# CORE_UPSTREAMS={"instagram":"http://127.0.0.1:3000","linkedin":"http://127.0.0.1:3002","tiktok":"http://127.0.0.1:3001"}
CORE_INSTAGRAM_URL=http://127.0.0.1:3000
CORE_LINKEDIN_URL=http://127.0.0.1:3002
CORE_TIKTOK_URL=http://127.0.0.1:3001
CORE_TIMEOUT_MS=20000

# --- Credits ------------------------------------------------------------
# Default credits for an admin-issued account / voucher.
CORE_DEFAULT_CREDITS=5000
# Starter balance for a public /v1/signup account (PayAsYouGo, no subscription).
CORE_STARTER_CREDITS=50
# Signup abuse limit per network per hour (hashed IP in memory only, never stored).
CORE_SIGNUP_PER_HOUR=5
# Max active API keys per account (rotation does not consume credits).
CORE_MAX_API_KEYS=20
# Per-minute rate limit per ACCOUNT (all its API keys share one budget).
CORE_RATE_PER_MIN=60
# Optional JSON array of [regex, cost] pairs. Costs follow upstream work:
# light metadata = 1, post lists = 3, aggregates = 2, people = 5.
# CORE_COSTS=[["^/v1/instagram/[^/]+/posts",3],["^/v1/linkedin/signals/",2]]

# --- Data policy --------------------------------------------------------
# Personal-data endpoints are blocked on the gateway by default.
CORE_ALLOW_PEOPLE=0
# Let clients generate their own account hash and send only its SHA-256.
# The gateway then never sees the raw unlock code at all.
CORE_ALLOW_CLIENT_HASH=0

# --- Storage ------------------------------------------------------------
# "file" (default) or "memory" (tests / ephemeral).
# v1 databases (keys.json with 16-digit keys) are migrated in place on read:
# those codes become unlock codes, credits are preserved, no API key is minted.
CORE_STORE=file
# CORE_DATA_DIR=./.data
# CORE_DATA_FILE=./.data/keys.json
# NO_COLOR=1
